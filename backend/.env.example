# ==========================================
# DoPaint 环境变量配置
# 复制此文件为 .env 并修改实际值
# ==========================================

# ---- 应用 ----
APP_NAME=DoPaint
APP_ENV=development          # development / production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-string
API_PREFIX=/api/v1

# ---- 数据库 ----
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/dopaint?charset=utf8mb4

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200    # 30天

# ---- 微信小程序 ----
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=your_wechat_app_secret

# ---- 微信支付 ----
WECHAT_PAY_MCH_ID=1234567890
WECHAT_PAY_API_V3_KEY=your_api_v3_key
WECHAT_PAY_SERIAL_NO=your_serial_no
WECHAT_PAY_PRIVATE_KEY_PATH=certs/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.dopaint.com/api/v1/orders/notify

# ---- 阿里云 OSS ----
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=dopaint-prod
OSS_CDN_DOMAIN=https://cdn.dopaint.com

# ---- 阿里万象 (DashScope) ----
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_VIDEO_MODEL=wanx-v1-image-to-video
DASHSCOPE_MAX_RETRY=3
DASHSCOPE_TIMEOUT=120

# ---- 阿里云视觉智能（图像预处理） ----
VISION_ACCESS_KEY_ID=your_vision_key_id
VISION_ACCESS_KEY_SECRET=your_vision_key_secret

# ---- 配额默认值 ----
DEFAULT_FREE_QUOTA=5               # 免费版月配额
DEFAULT_TRIAL_QUOTA=500            # 试用版月配额

# ---- 文件上传 ----
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,bmp
