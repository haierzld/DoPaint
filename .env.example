# ============================
# DoPaint 本地开发环境配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================

# ---- 应用 ----
APP_NAME=DoPaint
APP_ENV=development
APP_DEBUG=True
APP_SECRET_KEY=change-me-to-random-string
# 本地运行时必须是 localhost，否则 DashScope 回调无法访问
SELF_HOST=localhost:8000

# ---- 数据库 (本地 MySQL) ----
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/dopaint

# ---- Redis (本地) ----
REDIS_URL=redis://127.0.0.1:6379/0

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---- 微信小程序 ----
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- 微信支付 ----
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=

# ---- 阿里云 OSS ----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=dopaint-dev
OSS_CDN_DOMAIN=

# ---- 阿里万象 DashScope (必填) ----
DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_VIDEO_MODEL=wanx-v1-image-to-video
DASHSCOPE_MAX_RETRY=3
DASHSCOPE_TIMEOUT=120

# ---- 阿里云视觉智能 ----
VISION_ACCESS_KEY_ID=
VISION_ACCESS_KEY_SECRET=

# ---- 配额 ----
DEFAULT_FREE_QUOTA=5
DEFAULT_TRIAL_QUOTA=500

# ---- 上传限制 ----
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,bmp
